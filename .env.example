# ==============================================================================
# Root Environment Variables (Used by Docker Compose)
# Copy this file to .env and fill in the values
# ==============================================================================

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yakittakip_db

# JWT Secrets — REQUIRED. The backend refuses to start without these.
# Generate strong random values, e.g.: openssl rand -hex 64
# Never reuse these placeholders and never commit real secrets.
JWT_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_64__
JWT_REFRESH_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_64__

# MQTT (EMQX) credentials — REQUIRED. EMQX refuses to accept ANY connection
# (including anonymous ones) without these; the backend uses the same values
# to authenticate. Generate a strong password, e.g.: openssl rand -hex 32
MQTT_USERNAME=yakittakip_backend
MQTT_PASSWORD=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# ------------------------------------------------------------------------------
# docker-compose.yml bu anahtarları ZORUNLU kılar (`${VAR:?...}`): tanımsızsa `docker compose up` daha başlamadan durur.
# Hepsi için: openssl rand -hex 32  (aşağıdaki yer tutucular backend tarafından REDDEDİLİR — DOC-1203: yeni geliştirici 30 dakikada ayağa kalkabilsin diye eklendi).
# Ayrıntı ve anlamları: backend/.env.example ve docs/SECRETS.md
# ------------------------------------------------------------------------------
# Demo cihaz sırları (ESP32-PUMP-01 / TANK-01 / FLOW-ISR; gerçek cihazlar claim akışıyla kendi sırlarını alır)
HW_SECRET_ESP32_PUMP_01=__CHANGE_ME_RUN_openssl_rand_-hex_32__
HW_SECRET_ESP32_TANK_01=__CHANGE_ME_RUN_openssl_rand_-hex_32__
HW_SECRET_ESP32_FLOW_ISR=__CHANGE_ME_RUN_openssl_rand_-hex_32__
# İkmal kaydı değişmezlik mührü (HMAC) sırrı
TRANSACTION_HASH_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_32__
# AES-256-GCM anahtarları (tam 64 hex karakter): cihaz sırları / tenant dışa aktarım arşivi / bildirim kanalı sırları
HW_SECRET_ENCRYPTION_KEY=__CHANGE_ME_RUN_openssl_rand_-hex_32__
TENANT_EXPORT_ENCRYPTION_KEY=__CHANGE_ME_RUN_openssl_rand_-hex_32__
NOTIFICATION_CHANNEL_ENCRYPTION_KEY=__CHANGE_ME_RUN_openssl_rand_-hex_32__
