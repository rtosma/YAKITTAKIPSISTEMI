# ==============================================================================
# Root Environment Variables (Used by Docker Compose)
# Copy this file to .env and fill in the values
# ==============================================================================

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yakittakip_db

# JWT Secrets - ZORUNLU, varsayilani yoktur.
# Her ortam icin AYRI ve FARKLI degerler uretin (ikisi ayni olamaz):
#     openssl rand -base64 48
# En az 32 karakter olmali. Uretimde tanimsizsa sunucu baslamayi reddeder.
# Uretim disinda tanimsiz birakilirsa her acilista rastgele bir sir uretilir
# (o durumda her yeniden baslatma tum oturumlari dusurur).
JWT_SECRET=
JWT_REFRESH_SECRET=
