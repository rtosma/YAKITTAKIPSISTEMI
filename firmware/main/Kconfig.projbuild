menu "Yakıt Takip pompa ünitesi"

    config YT_DEVICE_TYPE
        string "MQTT topic'indeki cihaz tipi"
        default "pump"

    config YT_PIN_RELAY
        int "Röle (pompa/solenoid) GPIO"
        default 13
        help
            Röle sürücü girişinde fiziksel pull-down direnci ZORUNLUDUR (README "Röle güvenliği").

    config YT_RELAY_ACTIVE_HIGH
        bool "Röle modülü HIGH ile çeker"
        default y

    config YT_PIN_FLOW
        int "Akışmetre pals girişi GPIO (PCNT)"
        default 14

    config YT_FLOW_GLITCH_NS
        int "Akışmetre glitch filtresi (ns) — bundan kısa darbeler gürültü"
        default 10000
        range 0 12700
        help
            ESP32 PCNT donanım filtresi en fazla ~12,7 µs eler. Reed kontaklı sayaçlarda
            harici RC filtre şarttır (yt_pcnt.h).

    config YT_PIN_ESTOP
        int "Acil durdurma girişi GPIO (normalde kapalı kontak)"
        default 27
        help
            Kontak GPIO ile GND arasına bağlanır, dahili pull-up açılır. Normalde LOW;
            basılınca VEYA tel koparsa HIGH → röle kapanır. Kontağı bağlanmamış bir
            geliştirme kartında pini GND'ye köprüleyin, yoksa röle hiç açılmaz.

    config YT_PIN_POWER_FAIL
        int "Güç kesintisi erken uyarı girişi GPIO (-1 = yok)"
        default -1
        range -1 39
        help
            Besleme regülatör öncesinde bir karşılaştırıcıyla izlenir; LOW = besleme
            düşüyor. Tutma kondansatörü en az 50 ms enerji sağlamalı. Sinyal gelince
            röle kapatılır ve totalizatör hemen NVS'e yazılır (FW-1314). ESP32'nin dahili
            brown-out dedektörü çipi doğrudan resetler, yazma fırsatı vermez.

    config YT_RFID_ENABLE
        bool "PN532 RFID okuyucu (I2C)"
        default y

    config YT_RFID_REMOVAL_ENDS_DISPENSE
        bool "Kart okuyucudan çekilince ikmali bitir"
        depends on YT_RFID_ENABLE
        default n
        help
            Açıkken sürücü kartı ikmal boyunca okuyucuda tutmalıdır; çekince röle kesilir
            (CARD_REMOVED). Kapalıyken kart bir kez okutulur, ikmal akış durunca biter.
            Okuyucunun tabancaya göre konumuna göre sahada karar verilir (FW-1302).

    config YT_PIN_I2C_SDA
        int "PN532 RFID I2C SDA"
        default 21

    config YT_PIN_I2C_SCL
        int "PN532 RFID I2C SCL"
        default 22

    config YT_NTP_SERVER
        string "NTP sunucusu"
        default "pool.ntp.org"
        help
            Saat ayrıca her sunucu yanıtındaki Date başlığından da eşitlenir (FW-1312).

    config YT_NET_OPENETH
        bool "QEMU: emüle Ethernet (openeth) — yalnızca test"
        depends on ETH_USE_OPENETH
        default n

    config YT_DEV_ALLOW_PLAINTEXT
        bool "GELİŞTİRME: şifresiz http:// ve mqtt:// sunucu adreslerine izin ver"
        default n
        help
            Yalnızca QEMU/yerel test içindir. Üretimde AÇILMAMALI: HMAC imzası HTTP gövdesini
            korur ama dinleyen biri kartları ve oturumları görür, sahte saat verebilir; MQTT'de
            ise sahte FORCE_CUTOFF/kalibrasyon komutu enjekte edebilir (FW-1307).

    config YT_DEV_CONSOLE
        bool "GELİŞTİRME: seri konsoldan kart okutma ve akış simülasyonu"
        default n
        help
            Donanımsız test için: "kart <uid>", "akis <litre> <L/dk>", "durum".
            Üretimde kapalı kalmalı.

    config YT_DEFAULT_K_FACTOR
        int "Varsayılan K-faktörü (pals/litre) — NVS'te değer yoksa"
        default 450

endmenu
