# ==============================================================================
# Backend Environment Variables
# ==============================================================================

# PostgreSQL Database Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yakittakip_db

# Redis Connection (refresh token store, rate limiters, nonce/lockout — bkz. redisPool.ts)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets — REQUIRED. The backend refuses to start without these.
# Generate strong random values, e.g.: openssl rand -hex 64
# Never reuse these placeholders and never commit real secrets.
JWT_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_64__
JWT_REFRESH_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_64__

# MQTT (EMQX) — REQUIRED, must match the credentials seeded on the broker
# (see docker/emqx/entrypoint.sh). EMQX no longer accepts anonymous clients.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=yakittakip_backend
MQTT_PASSWORD=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# Hardware device secrets (AUTH-202 HMAC-SHA256 signing key per ESP32 device
# — see hardwareAuthMiddleware.ts). REQUIRED. AUTH-202.3 (provisioning/
# rotation) isn't built yet, so these are static per-device secrets — but
# they must never be hardcoded in source (OPS-1105: gitleaks scans for this).
HW_SECRET_ESP32_PUMP_01=__CHANGE_ME_RUN_openssl_rand_-hex_32__
HW_SECRET_ESP32_TANK_01=__CHANGE_ME_RUN_openssl_rand_-hex_32__
HW_SECRET_ESP32_FLOW_ISR=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# FUEL-401.4: finalize edilen ikmal kayıtlarına "değişmezlik mührü"
# (hash_signature) eklemek için kullanılan sunucu sırrı. REQUIRED.
TRANSACTION_HASH_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# AUTH-202.3: hardware_devices.encrypted_secret'ı şifrelemek/çözmek için
# kullanılan AES-256-GCM anahtarı. Tam olarak 32 bayt (64 hex karakter)
# olmalıdır — openssl rand -hex 32 çıktısı zaten bu formattadır. REQUIRED.
HW_SECRET_ENCRYPTION_KEY=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
