# ==============================================================================
# Backend Environment Variables
# ==============================================================================

# PostgreSQL Database Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yakittakip_db

# Redis Connection (refresh token store, rate limiters, nonce/lockout — bkz. redisPool.ts)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets — REQUIRED. The backend refuses to start without these.
# Generate strong random values, e.g.: openssl rand -hex 64
# Never reuse these placeholders and never commit real secrets.
JWT_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_64__
JWT_REFRESH_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_64__

# MQTT (EMQX) — REQUIRED, must match the credentials seeded on the broker
# (see docker/emqx/entrypoint.sh). EMQX no longer accepts anonymous clients.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=yakittakip_backend
MQTT_PASSWORD=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
