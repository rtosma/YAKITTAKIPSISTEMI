# ==============================================================================
# Backend Environment Variables
# ==============================================================================

# PostgreSQL Database Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yakittakip_db

# Redis Connection (refresh token store, rate limiters, nonce/lockout — bkz. redisPool.ts)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets — REQUIRED. The backend refuses to start without these.
# Generate strong random values, e.g.: openssl rand -hex 64
# Never reuse these placeholders and never commit real secrets.
JWT_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_64__
JWT_REFRESH_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_64__

# MQTT (EMQX) — REQUIRED, must match the credentials seeded on the broker
# (see docker/emqx/entrypoint.sh). EMQX no longer accepts anonymous clients.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=yakittakip_backend
MQTT_PASSWORD=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# Hardware device secrets (AUTH-202 HMAC-SHA256 signing key per ESP32 device
# — see hardwareAuthMiddleware.ts). REQUIRED. AUTH-202.3 (provisioning/
# rotation) isn't built yet, so these are static per-device secrets — but
# they must never be hardcoded in source (OPS-1105: gitleaks scans for this).
HW_SECRET_ESP32_PUMP_01=__CHANGE_ME_RUN_openssl_rand_-hex_32__
HW_SECRET_ESP32_TANK_01=__CHANGE_ME_RUN_openssl_rand_-hex_32__
HW_SECRET_ESP32_FLOW_ISR=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# FUEL-401.4: finalize edilen ikmal kayıtlarına "değişmezlik mührü"
# (hash_signature) eklemek için kullanılan sunucu sırrı. REQUIRED.
TRANSACTION_HASH_SECRET=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# AUTH-202.3: hardware_devices.encrypted_secret'ı şifrelemek/çözmek için
# kullanılan AES-256-GCM anahtarı. Tam olarak 32 bayt (64 hex karakter)
# olmalıdır — openssl rand -hex 32 çıktısı zaten bu formattadır. REQUIRED.
HW_SECRET_ENCRYPTION_KEY=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# ARCH-108: tenant veri dışa aktarım arşivini şifrelemek için kullanılan
# AES-256-GCM anahtarı. Tam olarak 32 bayt (64 hex karakter) olmalıdır. REQUIRED.
TENANT_EXPORT_ENCRYPTION_KEY=__CHANGE_ME_RUN_openssl_rand_-hex_32__

# AI-502: Google Gemini SDK ile şoför/araç tüketim anomali analizi.
# OPSİYONELDİR — tanımlı değilse özellik devre dışı kalır (POST
# /ai/consumption-anomaly-reports 503 döner, haftalık otomatik analiz
# zamanlayıcısı hiç başlamaz); uygulamanın geri kalanı normal çalışır.
# https://aistudio.google.com/apikey adresinden alınabilir.
GEMINI_API_KEY=

# IOT-302.1: ChirpStack/TTN LoRaWAN uplink webhook'u (POST /api/v1/lorawan/uplink)
# için paylaşılan doğrulama token'ı. FAIL-CLOSED — tanımlı DEĞİLSE endpoint
# tüm çağrıları 503 ile reddeder (doğrulanmamış çağrı = sahte tank seviyesi
# enjeksiyonu riski). Ağ sunucusunda "Authorization: Bearer <token>" olarak
# ayarlayın. En az 24 karakter (öneri: openssl rand -hex 32).
LORAWAN_WEBHOOK_TOKEN=

# AUTH-207: "true" ise SUPER_ADMIN ve COMPANY_OWNER hesapları için TOTP 2FA
# kurulumu zorunlu olur (kurmadan API'ye erişemezler). Varsayılan/boş = kapalı.
# 2FA'yı kendi isteğiyle kuran kullanıcılar bu bayraktan bağımsız korunur.
TOTP_ENFORCED=false

# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# TEST_PLAN §5.2 — CORS allowlist (virgülle ayrılmış). BOŞ/TANIMSIZ = CORS
# tamamen kapalı (same-origin). nginx SPA'yı ve /api'yi aynı origin'den
# sunduğu için normal kurulumda boş bırakılır. Yalnızca API'ye BAŞKA bir
# origin'den (ayrı domain'de panel, mobil web, staging) erişilecekse doldurun:
#   CORS_ALLOWED_ORIGINS=https://panel.ornek.com,https://staging.ornek.com
CORS_ALLOWED_ORIGINS=
