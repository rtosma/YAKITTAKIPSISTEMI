{
  "name": "yakittakip-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "start": "node dist/server.cjs",
    "build": "esbuild src/bootstrap.ts --bundle --platform=node --target=node20 --format=cjs --external:argon2 --external:pg-native --external:swagger-ui-express --external:swagger-jsdoc --external:libxmljs2 --external:pdfkit --external:esbuild --outfile=dist/server.cjs && esbuild src/iot/payloadValidationWorker.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/payloadValidationWorker.cjs",
    "seed": "tsx src/db/seed.ts",
    "lint": "tsc --noEmit",
    "typecheck:unit": "tsc --noEmit -p tsconfig.unit.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@sentry/node": "^10.75.0",
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "libxmljs2": "^0.37.0",
    "mqtt": "^5.15.2",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "redlock": "^4.2.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/pino-http": "^5.8.4",
    "@types/smtp-server": "^3.5.13",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.0",
    "smtp-server": "^3.19.13",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11"
  }
}
